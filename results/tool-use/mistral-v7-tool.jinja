{{- bos_token }}
{%- set sys = namespace(text='') %}
{%- for message in messages %}
  {%- if message['role'] == 'system' %}{%- set sys.text = message['content'] %}{%- endif %}
{%- endfor %}
{%- for message in messages %}
  {%- if message['role'] == 'user' %}
    {%- if loop.index0 == 0 and sys.text %}{{- '[SYSTEM_PROMPT]' + sys.text + '[/SYSTEM_PROMPT]' }}{%- endif %}
    {%- if loop.last and tools %}{{- '[AVAILABLE_TOOLS][' }}{%- for t in tools %}{{- t | tojson }}{%- if not loop.last %}{{- ', ' }}{%- endif %}{%- endfor %}{{- '][/AVAILABLE_TOOLS]' }}{%- endif %}
    {{- '[INST]' + message['content'] + '[/INST]' }}
  {%- elif message['role'] == 'assistant' %}
    {%- if message.tool_calls %}{{- '[TOOL_CALLS][' }}{%- for tc in message.tool_calls %}{{- {'name': tc.function.name, 'arguments': tc.function.arguments} | tojson }}{%- if not loop.last %}{{- ', ' }}{%- endif %}{%- endfor %}{{- ']' + eos_token }}{%- else %}{{- message['content'] + eos_token }}{%- endif %}
  {%- elif message['role'] == 'tool' %}{{- '[TOOL_RESULTS]' + message['content'] + '[/TOOL_RESULTS]' }}
  {%- endif %}
{%- endfor %}
